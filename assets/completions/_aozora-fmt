#compdef aozora-fmt

autoload -U is-at-least

_aozora-fmt() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--color=[When to colourise --diff output]:WHEN:((auto\:"Colour when stdout is a terminal (honours \`NO_COLOR\`)"
always\:"Always colour, even when piped"
never\:"Never colour"))' \
'(-w --write -l --list)--check[Verify inputs are already formatted; exit 1 if any would change]' \
'(--check --diff --json)-w[Rewrite files in place (no-op when already canonical)]' \
'(--check --diff --json)--write[Rewrite files in place (no-op when already canonical)]' \
'(-w --write -l --list --json)--diff[Print a unified diff for every file that would change. Implies --check]' \
'(--check --diff --json)-l[List only the paths that would change (gofmt -l). Combine with -w]' \
'(--check --diff --json)--list[List only the paths that would change (gofmt -l). Combine with -w]' \
'(-w --write -l --list --diff)--json[Emit the --check result as machine-readable JSON. Implies --check]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
'*::paths -- Files or directories to format. Use `-`, or omit, to read stdin:_files' \
&& ret=0
}

(( $+functions[_aozora-fmt_commands] )) ||
_aozora-fmt_commands() {
    local commands; commands=()
    _describe -t commands 'aozora-fmt commands' commands "$@"
}

if [ "$funcstack[1]" = "_aozora-fmt" ]; then
    _aozora-fmt "$@"
else
    compdef _aozora-fmt aozora-fmt
fi
